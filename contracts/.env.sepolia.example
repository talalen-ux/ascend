# --------------------------------------------------------------------
# Sepolia deploy env. Copy to contracts/.env.sepolia and fill in.
# Loaded by scripts/deploy-sepolia.sh.
# --------------------------------------------------------------------

# Deployer key. The account must hold ≥ 1 Sepolia ETH (the bootstrap)
# plus enough for deploy gas (~0.05–0.2 ETH at typical Sepolia gas).
PRIVATE_KEY=0x...

# Canonical Uniswap V4 PoolManager on Sepolia (chainId 11155111).
# Source: https://developers.uniswap.org/contracts/v4/deployments
POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# Sepolia RPC URL. Public RPCs throttle CREATE2 mining and large gas
# transactions — strongly recommend Alchemy/Infura/etc. with an API key.
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# Optional. If set, the deploy script will pass --verify to forge.
ETHERSCAN_API_KEY=
