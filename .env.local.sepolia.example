# --------------------------------------------------------------------
# Sepolia dapp env. Copy to .env.local AFTER the contracts deploy
# (scripts/deploy-sepolia.sh prints the hook / ascend / TileEngine /
# AscendRouter addresses; paste them in here, then npm run dev).
# --------------------------------------------------------------------

NEXT_PUBLIC_CHAIN_ID=11155111

# Optional. If unset the dapp falls back to https://sepolia.drpc.org.
# Anything in NEXT_PUBLIC_* is bundled into the client — do not put a
# paid/rate-limited API key here in production.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Canonical Uniswap V4 PoolManager on Sepolia.
NEXT_PUBLIC_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# Filled in from the deploy output (forge script prints these):
NEXT_PUBLIC_ASCEND_HOOK=0x...
NEXT_PUBLIC_ASCEND_TOKEN=0x...
NEXT_PUBLIC_TILE_ENGINE=0x...
NEXT_PUBLIC_ASCEND_ROUTER=0x...
NEXT_PUBLIC_POOL_ID=0x...
